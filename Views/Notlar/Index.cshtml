@model IEnumerable<KisiselAjandaWeb.Models.BagimsizNot>
@{
    ViewData["Title"] = "Bağımsız Notlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .notes-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .notes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .note-card { background-color: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 20px; display: flex; flex-direction: column; transition: transform 0.2s, border-color 0.2s; }
    .note-card:hover { transform: translateY(-3px); border-color: #3f3f46; }
    .note-badge { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; color: #fff; margin-bottom: 12px; align-self: flex-start; }
    .note-title { font-size: 1.15rem; font-weight: 600; color: #fafafa; margin-bottom: 10px; }
    .note-content { font-size: 0.9rem; color: #a1a1aa; white-space: pre-wrap; flex-grow: 1; margin-bottom: 16px; }
    .note-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #27272a; padding-top: 12px; font-size: 0.8rem; color: #71717a; }
    .note-actions a { color: #a1a1aa; margin-left: 12px; text-decoration: none; transition: color 0.2s; }
    .note-actions a.edit-btn:hover { color: #f59e0b; }
    .note-actions a.del-btn:hover { color: #ef4444; }
</style>

<div class="notes-header">
    <h3 class="m-0"><i class="fa-solid fa-note-sticky me-2"></i> Bağımsız Notlar</h3>
    <a href="/Notlar/Ekle" class="btn btn-success btn-sm" style="background-color: #10b981; border: none; border-radius: 8px; padding: 8px 16px;">
        <i class="fa-solid fa-plus"></i> Yeni Not Ekle
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="notes-grid">
        @foreach (var not in Model)
        {
            var renk = not.Kategori?.RenkKodu ?? "#3f3f46";
            var kategoriAdi = not.Kategori?.KategoriAdi ?? "Genel";

            <div class="note-card" style="border-top: 4px solid @renk;">
                <span class="note-badge" style="background-color: @renk;">@kategoriAdi</span>
                <div class="note-title">@not.Baslik</div>
                <div class="note-content">@not.Icerik</div>
                <div class="note-footer">
                    <span>
                        @if (not.GuncellenmeTarihi.HasValue)
                        {
                            <text>Güncellendi: @not.GuncellenmeTarihi.Value.ToString("dd.MM.yyyy HH:mm")</text>
                        }
                        else
                        {
                            <text>@not.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</text>
                        }
                    </span>
                    <div class="note-actions">
                        <a href="/Notlar/Guncelle/@not.NotID" class="edit-btn" title="Düzenle"><i class="fa-solid fa-pen"></i></a>
                        <a href="/Notlar/Sil/@not.NotID" class="del-btn" title="Sil" onclick="return confirm('Bu notu silmek istediğinize emin misiniz?');"><i class="fa-solid fa-trash"></i></a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center p-5" style="background-color: #18181b; border: 1px solid #27272a; border-radius: 12px; color: #71717a;">
        Henüz eklenmiş bir not bulunmuyor. Sağ üstten ilk notunu oluşturabilirsin.
    </div>
}