@model KisiselAjandaWeb.Models.Yapilacak
@{
    ViewData["Title"] = "Yeni Görev Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<style>
    .todo-container { max-width: 600px; margin: 2rem auto; color: #e4e4e7; }
    .todo-card { background-color: #18181b; border: 1px solid #27272a; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.5); padding: 20px; }
    .todo-header { border-bottom: 1px solid #3f3f46; padding-bottom: 15px; margin-bottom: 20px; }
    .todo-header h4 { margin: 0; color: #fafafa; font-weight: 600; }
    
    .dark-label { color: #a1a1aa; font-weight: 500; font-size: 0.9rem; margin-bottom: 8px; display: block; }
    .dark-input { background-color: #27272a; border: 1px solid #3f3f46; color: white; border-radius: 8px; padding: 10px 15px; width: 100%; margin-bottom: 20px; transition: all 0.3s; }
    .dark-input:focus { border-color: #10b981; outline: none; box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2); }
</style>

<div class="todo-container">
    <div class="todo-card">
        <div class="todo-header">
            <h4><i class="fa-solid fa-plus-circle text-success"></i> Yeni Görev Oluştur</h4>
        </div>
        
        <form asp-controller="Yapilacaklar" asp-action="Ekle" method="post">
            <div class="form-group">
                <label class="dark-label">Görev Metni (Ne yapılmalı?)</label>
                <input type="text" class="dark-input" asp-for="GorevMetni" placeholder="Örn: SQL ödevini tamamla..." required autocomplete="off">
            </div>

            <div class="form-group">
                <label class="dark-label">Tarih</label>
                <input type="date" class="dark-input" asp-for="Tarih" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <a href="/Yapilacaklar/Index" class="btn btn-outline-secondary" style="border-radius: 8px;">Geri Dön</a>
                <button type="submit" class="btn btn-success" style="border-radius: 8px; background-color: #10b981; border: none;">
                    <i class="fa-solid fa-save"></i> Görevi Kaydet
                </button>
            </div>
        </form>
    </div>
</div>