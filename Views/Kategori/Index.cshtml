@model IEnumerable<KisiselAjandaWeb.Models.Kategori>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
}

<div class="card card-dark">
    <div class="card-header">
        <h3 class="card-title">Kategori Listesi</h3>
        <div class="card-tools">
            <a href="/Kategori/Ekle" class="btn btn-success btn-sm">
                <i class="fas fa-plus"></i> Yeni Kategori Ekle
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th style="width: 50px">ID</th>
                    <th>Kategori Adı</th>
                    <th>Renk Kodu</th>
                    <th style="width: 150px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.KategoriID</td>
                        <td>@item.KategoriAdi</td> 
                        <td><span class="badge" style="background-color: @item.RenkKodu">@item.RenkKodu</span></td>
                        <td>
                            <a href="/Kategori/Guncelle/@item.KategoriID" class="btn btn-warning btn-sm" title="Güncelle">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="/Kategori/Sil/@item.KategoriID" class="btn btn-danger btn-sm" title="Sil">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>